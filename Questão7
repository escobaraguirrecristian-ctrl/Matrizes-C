#include <stdio.h>

int main () {
    int matriz [3] [3];
    int i, j;

    // Lendo os dados da matriz
    printf("Digite os elementos da matriz 3x3:\n");
    for(i=0; i<3; i++) {          
        for(j=0; j<3; j++) {
            printf("Elemento [%d][%d]: ", i, j);
            scanf("%d", &matriz[i][j]);
        }
    }

    printf("\n--- Diagonal Principal ---\n");
    for(i=0; i<3; i++) {
        // Na diagonal principal, o índice da linha é igual ao da coluna (i == j)
        printf("%4d", matriz[i][i]); 
    }
    printf("\n-------------------------\n");

    return 0;
}
